NODE_ENV=development
PORT=5000

CLIENT_URLS=http://localhost:5173,http://localhost:4173
PUBLIC_SITE_URL=http://localhost:5173

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key

EMAIL_FROM_NAME=Sankhya Portfolio
EMAIL_FROM_ADDRESS=verified-sender@example.com

PORTFOLIO_TO_EMAIL=your-personal-email@example.com

# Optional but recommended. If omitted, BREVO_SMTP_KEY is used to derive the verification-token key.
CONTACT_VERIFICATION_SECRET=replace_with_a_long_random_secret